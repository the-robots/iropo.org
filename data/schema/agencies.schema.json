{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iropo.org/schema/agencies.schema.json",
  "title": "Agencies of one state",
  "description": "FBI agency directory entries joined to yearly NIBRS offense counts from the Offense Type by Agency tables.",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "name", "table_years", "agencies"],
  "$defs": {
    "yearCounts": {
      "type": "object",
      "propertyNames": { "pattern": "^20[0-9]{2}$" },
      "additionalProperties": { "type": ["integer", "null"], "minimum": 0 }
    }
  },
  "properties": {
    "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "name": { "type": "string" },
    "table_years": { "type": "array", "items": { "type": "integer" } },
    "agencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "ori": { "type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{7}$" },
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["city", "county", "university", "other", "other_state", "state_police", "tribal", "federal"] },
          "county": { "type": "string" },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "nibrs": { "type": "boolean" },
          "nibrs_since": { "type": "string", "format": "date" },
          "table_name": { "type": "string" },
          "population": { "type": "integer", "minimum": 0 },
          "enrollment": { "type": "integer", "minimum": 0 },
          "animal_cruelty": { "$ref": "#/$defs/yearCounts" },
          "total_offenses": { "$ref": "#/$defs/yearCounts" },
          "match": { "enum": ["exact", "normalized", "tokens", "none"] },
          "legacy_ori": { "type": "string" },
          "legacy_status": { "enum": ["current", "likely_ocr_error"] }
        }
      }
    }
  }
}
