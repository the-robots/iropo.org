---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noindex>
  <section class="section">
    <div class="container--narrow stack">
      <p class="eyebrow">404</p>
      <h1>We couldn't find that page</h1>
      <p class="lede">The page may have moved when the site was rebuilt. These are good places to start:</p>
      <ul>
        <li><a href="/data/">National animal cruelty data</a></li>
        <li><a href="/states/">Data for your state</a></li>
        <li><a href="/agencies/">Search law enforcement agencies</a></li>
        <li><a href="/registry/">How the registry works</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
