---
/**
 * Monthly line chart. The line is SVG with a non-scaling stroke; axes are HTML so text never
 * shrinks on small screens. Null months render as gaps.
 */
interface Props {
  values: (number | null)[];
  start: string; // YYYY-MM
  title: string;
  caption?: string;
  height?: number;
  unit?: string;
}

const { values, start, title, caption, height = 220, unit = "offenses" } = Astro.props;
const startYear = Number(start.slice(0, 4));
const startMonth = Number(start.slice(5, 7)) - 1;
const n = values.length;
const max = Math.max(1, ...values.map((v) => v ?? 0));
const niceMax = (() => {
  const pow = 10 ** Math.floor(Math.log10(max));
  const step = [1, 2, 2.5, 5, 10].find((s) => s * pow >= max / 4) ?? 10;
  return Math.ceil(max / (step * pow)) * step * pow;
})();
const ticks = [0, 0.25, 0.5, 0.75, 1].map((t) => Math.round(niceMax * t));

const segments: string[] = [];
let current: string[] = [];
values.forEach((v, i) => {
  if (v === null) {
    if (current.length) segments.push(current.join(" "));
    current = [];
    return;
  }
  const x = n > 1 ? (i / (n - 1)) * 1000 : 500;
  const y = 100 - (v / niceMax) * 100;
  current.push(`${x.toFixed(2)},${y.toFixed(2)}`);
});
if (current.length) segments.push(current.join(" "));

const years: { year: number; left: number }[] = [];
for (let i = 0; i < n; i++) {
  if ((startMonth + i) % 12 === 0) {
    years.push({ year: startYear + Math.floor((startMonth + i) / 12), left: n > 1 ? (i / (n - 1)) * 100 : 0 });
  }
}
const yearStep = years.length > 8 ? 2 : 1;
const monthLabel = (i: number) => {
  const year = startYear + Math.floor((startMonth + i) / 12);
  const month = (startMonth + i) % 12;
  return `${new Date(Date.UTC(year, month, 1)).toLocaleString("en-US", { month: "short", timeZone: "UTC" })} ${year}`;
};
const yearTotals = new Map<number, number>();
values.forEach((v, i) => {
  if (v === null) return;
  const year = startYear + Math.floor((startMonth + i) / 12);
  yearTotals.set(year, (yearTotals.get(year) ?? 0) + v);
});
const peak = values.reduce<{ i: number; v: number }>((best, v, i) => (v !== null && v > best.v ? { i, v } : best), { i: -1, v: -1 });
---

<figure class="chart line-chart">
  <div class="line-chart__frame" style={`--h:${height}px`} aria-hidden="true">
    <div class="line-chart__y">
      {ticks.slice().reverse().map((t) => <span>{t.toLocaleString("en-US")}</span>)}
    </div>
    <div class="line-chart__plot">
      {ticks.map((t) => <span class="line-chart__grid" style={`bottom:${(t / niceMax) * 100}%`} />)}
      <svg viewBox="0 0 1000 100" preserveAspectRatio="none">
        {segments.map((points) => <polyline points={points} />)}
      </svg>
      <div class="line-chart__x">
        {
          years
            .filter((_, i) => i % yearStep === 0)
            .map((y) => <span style={`left:${y.left}%`}>{y.year}</span>)
        }
      </div>
    </div>
  </div>
  <div class="visually-hidden">
  <table>
    <caption>{title} (yearly totals of monthly {unit})</caption>
    <thead><tr><th scope="col">Year</th><th scope="col">Total {unit}</th></tr></thead>
    <tbody>
      {[...yearTotals.entries()].map(([year, total]) => <tr><th scope="row">{year}</th><td>{total.toLocaleString("en-US")}</td></tr>)}
    </tbody>
  </table>
  </div>
  {
    caption && (
      <figcaption>
        {caption}
        {peak.i >= 0 && ` Highest month: ${monthLabel(peak.i)} (${peak.v.toLocaleString("en-US")}).`}
      </figcaption>
    )
  }
</figure>

<style>
  .line-chart__frame {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    height: calc(var(--h) + 1.8rem);
  }
  .line-chart__y {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: var(--h);
    font-size: 0.72rem;
    color: var(--muted);
    text-align: right;
    font-variant-numeric: tabular-nums;
    transform: translateY(-0.45em);
  }
  .line-chart__plot {
    position: relative;
    height: var(--h);
    border-bottom: 1px solid var(--border-strong);
  }
  .line-chart__grid {
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1px dashed var(--chart-grid);
  }
  .line-chart__plot svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  polyline {
    fill: none;
    stroke: var(--chart-line);
    stroke-width: 2.25;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .line-chart__x {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 1.6rem;
  }
  .line-chart__x span {
    position: absolute;
    top: 0.35rem;
    transform: translateX(-50%);
    font-size: 0.72rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .line-chart__x span::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -0.4rem;
    height: 0.3rem;
    border-left: 1px solid var(--border-strong);
  }
</style>
